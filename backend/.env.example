# ─── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Use SQLite for local dev (default):
DATABASE_URL=sqlite+aiosqlite:///./tasktalk.db
# Or PostgreSQL (Supabase / local pgAdmin):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/tasktalk

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Optional: Deepgram STT (browser Web Speech API is used by default) ──────
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
